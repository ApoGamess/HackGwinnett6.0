  "communication_phrases": [
    {
      "id": "demo-phrase-01",
      "group": "Communication",
      "groupEs": "Comunicación",
      "text": "I would prefer to type.",
      "textEs": "Prefiero escribir."
    },
    {
      "id": "demo-phrase-02",
      "group": "Communication",
      "groupEs": "Comunicación",
      "text": "Could you write that down?",
      "textEs": "¿Podría escribirlo?"
    },
    {
      "id": "demo-phrase-03",
      "group": "Communication",
      "groupEs": "Comunicación",
      "text": "Please speak directly to me.",
      "textEs": "Por favor, hábleme directamente."
    },
    {
      "id": "demo-phrase-04",
      "group": "Communication",
      "groupEs": "Comunicación",
      "text": "Please read the message on my screen.",
      "textEs": "Por favor, lea el mensaje en mi pantalla."
    },
    {
      "id": "demo-phrase-05",
      "group": "Time and understanding",
      "groupEs": "Tiempo y comprensión",
      "text": "Please give me more time.",
      "textEs": "Por favor, deme más tiempo."
    },
    {
      "id": "demo-phrase-06",
      "group": "Time and understanding",
      "groupEs": "Tiempo y comprensión",
      "text": "Please explain one step at a time.",
      "textEs": "Por favor, explique un paso a la vez."
    },
    {
      "id": "demo-phrase-07",
      "group": "Time and understanding",
      "groupEs": "Tiempo y comprensión",
      "text": "Please explain that again.",
      "textEs": "Por favor, explíquelo de nuevo."
    },
    {
      "id": "demo-phrase-08",
      "group": "Time and understanding",
      "groupEs": "Tiempo y comprensión",
      "text": "I need a moment to think.",
      "textEs": "Necesito un momento para pensar."
    },
    {
      "id": "demo-phrase-09",
      "group": "Finding my way",
      "groupEs": "Encontrar el camino",
      "text": "Where is the step-free entrance?",
      "textEs": "¿Dónde está la entrada sin escalones?"
