    {
      "id": "demo-phrase-10",
      "group": "Finding my way",
      "groupEs": "Encontrar el camino",
      "text": "Where is reception?",
      "textEs": "¿Dónde está recepción?"
    },
    {
      "id": "demo-phrase-11",
      "group": "Finding my way",
      "groupEs": "Encontrar el camino",
      "text": "Which elevator reaches the consultation room?",
      "textEs": "¿Qué ascensor llega al consultorio?"
