# Default provider is no-key MapLibre / OpenFreeMap. No paid service is needed.
VITE_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# Camera and browser geolocation require HTTPS or localhost. Do not add secrets here.
# Public VITE_* values are included in the client bundle.
# Google photorealistic 3D and public wheelchair routing are not enabled.
